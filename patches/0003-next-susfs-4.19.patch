 	if (err) {
diff --git a/kernel/feature/susfs_bridge.c b/kernel/feature/susfs_bridge.c
new file mode 100644
index 00000000..4034282a
--- /dev/null
+++ b/kernel/feature/susfs_bridge.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pixel 5 adapter for the pinned SUSFS 1.5.5 NON-GKI command ABI.
+ * This is a root-only control interface, not a legacy KernelSU root API.
+ */
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/namei.h>
+#include <linux/nsproxy.h>
+#include <linux/sched/task.h>
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+#include "selinux/selinux.h"
+
+extern void susfs_run_try_umount_for_current_mnt_ns(void);
+
+static u64 susfs_features(void)
+{
+    u64 mask = 0;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    mask |= BIT_ULL(0);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    mask |= BIT_ULL(1);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+    mask |= BIT_ULL(2);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+    mask |= BIT_ULL(3);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+    mask |= BIT_ULL(4);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_OVERLAYFS
+    mask |= BIT_ULL(5);
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+    mask |= BIT_ULL(6);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+    mask |= BIT_ULL(7);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+    mask |= BIT_ULL(8);
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+    mask |= BIT_ULL(9);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+    mask |= BIT_ULL(10);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+    mask |= BIT_ULL(11);
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+    mask |= BIT_ULL(12);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+    mask |= BIT_ULL(14);
+#endif
+    return mask;
+}
+
+long ksu_susfs_prctl(unsigned long cmd, unsigned long arg, unsigned long result)
+{
+    void __user *payload = (void __user *)arg;
+    int __user *status = (int __user *)result;
+    int error = -EOPNOTSUPP;
+    u64 features;
+
+    /* Do not turn a public magic number into an authorization mechanism. */
+    if (!uid_eq(current_uid(), GLOBAL_ROOT_UID) ||
+        !uid_eq(current_euid(), GLOBAL_ROOT_UID) || !is_ksu_domain())
+        return -ENOSYS;
+
+    /* Validate the reply pointer before performing a mutating operation. */
+    if (put_user(error, status))
+        return -EFAULT;
+
+    switch (cmd) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    case CMD_SUSFS_ADD_SUS_PATH:
+        error = susfs_add_sus_path(payload);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    case CMD_SUSFS_ADD_SUS_MOUNT:
+        error = susfs_add_sus_mount(payload);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+    case CMD_SUSFS_ADD_SUS_KSTAT:
+    case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+        error = susfs_add_sus_kstat(payload);
+        break;
+    case CMD_SUSFS_UPDATE_SUS_KSTAT:
+        error = susfs_update_sus_kstat(payload);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+    case CMD_SUSFS_ADD_TRY_UMOUNT:
+        error = susfs_add_try_umount(payload);
+        break;
+    case CMD_SUSFS_RUN_UMOUNT_FOR_CURRENT_MNT_NS:
+        /* Refuse to unmount Android's global mount namespace. */
+        if (current->nsproxy->mnt_ns == init_task.nsproxy->mnt_ns)
+            error = -EPERM;
+        else {
+            susfs_run_try_umount_for_current_mnt_ns();
+            error = 0;
+        }
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+    case CMD_SUSFS_SET_UNAME:
+        error = susfs_set_uname(payload);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+    case CMD_SUSFS_ENABLE_LOG:
+        if (arg > 1)
+            error = -EINVAL;
+        else {
+            susfs_set_log(arg != 0);
+            error = 0;
+        }
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+    case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+        error = susfs_set_cmdline_or_bootconfig(payload);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+    case CMD_SUSFS_ADD_OPEN_REDIRECT:
+        error = susfs_add_open_redirect(payload);
+        break;
+#endif
+    case CMD_SUSFS_SHOW_VERSION:
+        error = copy_to_user(payload, SUSFS_VERSION, sizeof(SUSFS_VERSION)) ? -EFAULT : 0;
+        break;
+    case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+        features = susfs_features();
+        error = copy_to_user(payload, &features, sizeof(features)) ? -EFAULT : 0;
+        break;
+    case CMD_SUSFS_SHOW_VARIANT:
+        error = copy_to_user(payload, SUSFS_VARIANT, sizeof(SUSFS_VARIANT)) ? -EFAULT : 0;
+        break;
+    case CMD_SUSFS_SHOW_SUS_SU_WORKING_MODE:
+    case CMD_SUSFS_IS_SUS_SU_READY:
+    case CMD_SUSFS_SUS_SU:
+        /* SUS_SU is not supported by this NON-GKI integration. */
+        break;
+    default:
+        return -ENOSYS;
+    }
+    return put_user(error, status) ? -EFAULT : 0;
+}
+
+static bool marker_exists(const char *name)
+{
+    struct path path;
+    if (kern_path(name, LOOKUP_FOLLOW, &path))
+        return false;
+    path_put(&path);
+    return true;
+}
+
+void ksu_susfs_post_fs_data(void)
+{
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+    extern bool susfs_is_auto_add_sus_bind_mount_enabled;
+    if (marker_exists(DATA_ADB_NO_AUTO_ADD_SUS_BIND_MOUNT))
+        susfs_is_auto_add_sus_bind_mount_enabled = false;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+    extern bool susfs_is_auto_add_sus_ksu_default_mount_enabled;
+    if (marker_exists(DATA_ADB_NO_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT))
+        susfs_is_auto_add_sus_ksu_default_mount_enabled = false;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+    extern bool susfs_is_auto_add_try_umount_for_bind_mount_enabled;
+    if (marker_exists(DATA_ADB_NO_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT))
+        susfs_is_auto_add_try_umount_for_bind_mount_enabled = false;
+#endif
+}
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 510057ff..f006ca76 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -24,8 +24,25 @@
 #include "feature/kernel_umount.h"
 #include "compat/kernel_compat.h"
 
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+#include "selinux/selinux.h"
+#endif
+
 int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 {
+#ifdef CONFIG_KSU_SUSFS
+    if (is_zygote(current_cred())) {
+        bool protected_app = (is_appuid(new_uid) || is_isolated_process(new_uid)) &&
+            !is_uid_manager(new_uid) && !ksu_is_allow_uid(new_uid);
+        task_lock(current);
+        if (protected_app)
+            current->susfs_task_state |= TASK_STRUCT_NON_ROOT_USER_APP_PROC;
+        else
+            current->susfs_task_state &= ~TASK_STRUCT_NON_ROOT_USER_APP_PROC;
+        task_unlock(current);
+    }
+#endif
     // we rely on the fact that zygote always call setresuid(3) with same uids
 
     pr_info("handle_setresuid from %d to %d\n", old_uid, new_uid);
