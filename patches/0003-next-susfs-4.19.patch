diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index 275dde8d..c5cf7835 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -95,8 +95,34 @@ static void try_umount(const char *mnt, int flags)
     ksu_umount_mnt(mnt, &path, flags);
 }
 
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+#include <linux/susfs.h>
+extern bool susfs_is_mnt_devname_ksu(struct path *path);
+
+void ksu_try_umount(const char *mnt, bool check_mnt, int flags, uid_t uid)
+{
+    struct path path;
+    if (kern_path(mnt, 0, &path))
+        return;
+    if (path.dentry != path.mnt->mnt_root ||
+        (check_mnt && !susfs_is_mnt_devname_ksu(&path))) {
+        path_put(&path);
+        return;
+    }
+    ksu_umount_mnt(mnt, &path, flags);
+}
+
+void susfs_try_umount_all(uid_t uid)
+{
+    susfs_try_umount(uid);
+}
+#endif
+
